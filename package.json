{
  "name": "arkmap",
  "version": "1.0.0",
  "description": "Mudlet map toolkit for Node.js and the browser: read/write .dat and .arkmap maps, validate, XXH3-64 checksums, map diff, .arkdelta edit deltas (validate/build/apply, Ed25519 signature verification), routing, transports, waypoint route codes, token-indexed search, SVG/PNG rendering. Zero dependencies, ESM, EN/PL.",
  "author": "Isithunzi000",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./arkadia": "./src/arkadia.js",
    "./arkadia/transports": "./src/arkadia-transports.js",
    "./graph": "./src/graph.js",
    "./transports": "./src/transports.js",
    "./waypoints": "./src/waypoints.js",
    "./diff": "./src/diff.js",
    "./search-index": "./src/search-index.js",
    "./render-svg": "./src/render-svg.js",
    "./render-png": "./src/render-png.js",
    "./package.json": "./package.json",
    "./delta-validate": "./src/delta-validate.js",
    "./delta-build": "./src/delta-build.js",
    "./delta-apply": "./src/delta-apply.js"
  },
  "files": [
    "src/",
    "EXTRACT_MANIFEST.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "test": "node scripts/run-tests.mjs",
    "parity": "node scripts/extract.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Isithunzi000/arkmap"
  },
  "keywords": [
    "mudlet",
    "mud",
    "arkadia",
    "map",
    "arkmap",
    "dat",
    "mapper",
    "arkdelta",
    "mudlet-map"
  ]
}
